exports[`createQueryFile > complex response schema > produces the correct output with complex response schema 1`] = `
"// ------------------------------
// Auto-generated query file for GET /users
// This file is generated by Route Ink. Do not edit manually.
// ------------------------------
import { useSuspenseQuery, type QueryKey, type UseSuspenseQueryOptions } from "@tanstack/react-query";
import type { AxiosInstance } from "axios";
import type { Except } from "type-fest";
import z from "zod/v4";
import { UserSchema } from "@workspace/schemas";
import { buildQueryKey, useAxiosInstance } from "../util";

const ResponseSchema = PaginatedResponse(UserSchema);

export const getUsersQueryKey = (): QueryKey => buildQueryKey("/users");

export const getUsers = async (axios: AxiosInstance, config?: { signal?: AbortSignal }): Promise<z.infer<typeof ResponseSchema>> => {
  const url = "/users";

  const response = await axios.get(url, {
    signal: config?.signal,
  });

  return ResponseSchema.parse(response.data);
};

export const useGetUsersSuspenseQuery = (options?: Except<UseSuspenseQueryOptions<z.infer<typeof ResponseSchema>>, "queryFn">) => {
  const axios = useAxiosInstance();

  return useSuspenseQuery({
    queryKey: getUsersQueryKey(),
    queryFn: (context) => getUsers(axios, { signal: context.signal }),
    ...options,
  });
};
"
`;

