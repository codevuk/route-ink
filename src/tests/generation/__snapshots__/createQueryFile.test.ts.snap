"// ------------------------------
// Auto-generated query file for GET /users/:id
// This file is generated by Route Ink. Do not edit manually.
// ------------------------------
import { queryOptions, useSuspenseQuery, type QueryKey, type UseSuspenseQueryOptions } from "@tanstack/react-query";
import type { AxiosInstance } from "axios";
import type { Except } from "type-fest";
import z from "zod/v4";
import { UserSchema, UserParamsSchema } from "@workspace/schemas";
import { buildQueryKey, injectParams, useAxiosInstance } from "../util";

export type GetUserInput = {
  params: z.output<typeof UserParamsSchema>;
};

export const getUserQueryKey = (input: GetUserInput): QueryKey => {
  const { params } = input;

  return buildQueryKey(injectParams("/users/:id", UserParamsSchema, params));
};

export const getUser = async (axios: AxiosInstance, input: GetUserInput, config?: { signal?: AbortSignal }): Promise<z.infer<typeof UserSchema>> => {
  const { params } = input;

  const url = injectParams("/users/:id", UserParamsSchema, params);

  const response = await axios.get(url, {
    signal: config?.signal,
  });

  return UserSchema.parse(response.data);
};

export const getUserQueryOptions = (axios: AxiosInstance, input: GetUserInput) => queryOptions({
  queryKey: getUserQueryKey(input),
  queryFn: (context) => getUser(axios, input, { signal: context.signal }),
});

export const useGetUserSuspenseQuery = (input: GetUserInput, options?: Except<UseSuspenseQueryOptions<z.infer<typeof UserSchema>>, "queryFn">) => {
  const axios = useAxiosInstance();

  return useSuspenseQuery({
    ...getUserQueryOptions(axios, input),
    ...options,
  });
};
"
`;

