export type DeleteUserInput = {
  params: z.output<typeof UserParamsSchema>;
};

export const deleteUser = async (axios: AxiosInstance, input: DeleteUserInput): Promise<undefined> => {
  const { params } = input;

  const url = injectParams("/users/:id", UserParamsSchema, params);

  await axios.delete(url);

  return undefined;
};

export const deleteUserInvalidationKey = (input: Pick<DeleteUserInput, "params">): QueryKey => injectParams("/users/:id", UserParamsSchema, input.params)
  .split("/")
