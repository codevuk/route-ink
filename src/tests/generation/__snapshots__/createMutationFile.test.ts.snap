export const createUser = async (axios: AxiosInstance, input: CreateUserInput): Promise<z.output<typeof UserSchema>> => {
  const { body } = input;

  const url = "/users";

  const response = await axios.post(url, body);

  return UserSchema.parse(response.data);
};

export const createUserInvalidationKey = (): QueryKey => "/users"
  .split("/")
  .filter(Boolean)
  .slice(0, -1);

type Options = UseMutationOptions<
  z.output<typeof UserSchema>,
  QueryError,
  CreateUserInput
> & {
  queryKeyInvalidation?: string[] | ((response: z.output<typeof UserSchema> | undefined) => string[]);
};

export const useCreateUserMutation = (options: Except<Options, "onSettled" | "mutationFn"> = {}) => {
  const axios = useAxiosInstance();
  const { queryKeyInvalidation } = options;

  const client = useQueryClient();

  return useMutation({
    mutationFn: (input: CreateUserInput) => createUser(axios, input),
    onSettled: (response) => {
      const invalidationKeys = typeof queryKeyInvalidation === "function"
        ? queryKeyInvalidation(response)
        : queryKeyInvalidation;

      if (invalidationKeys) {
        client.invalidateQueries({ queryKey: invalidationKeys });
        return;
      }

      client.invalidateQueries({ queryKey: createUserInvalidationKey() });
    },
    ...options,
  });
};
"
`;

exports[`createMutationFile > mutation-with-body-and-params > produces the correct output 1`] = `
"// ------------------------------
// Auto-generated mutation file for PUT /users/:id
// This file is generated by Route Ink. Do not edit manually.
// ------------------------------
import { useMutation, useQueryClient, type QueryKey, type UseMutationOptions } from "@tanstack/react-query";
import type { AxiosInstance } from "axios";
import type { Except } from "type-fest";
import z from "zod/v4";
import { UserSchema, UpdateUserBodySchema, UserParamsSchema } from "@workspace/schemas";
import { injectParams, QueryError, useAxiosInstance } from "../util";

export type UpdateUserInput = {
  params: z.output<typeof UserParamsSchema>;
  body: z.output<typeof UpdateUserBodySchema>;
};

export const updateUser = async (axios: AxiosInstance, input: UpdateUserInput): Promise<z.output<typeof UserSchema>> => {
  const { params, body } = input;

  const url = injectParams("/users/:id", UserParamsSchema, params);

  const response = await axios.put(url, body);

  return UserSchema.parse(response.data);
};

export const updateUserInvalidationKey = (input: Pick<UpdateUserInput, "params">): QueryKey => injectParams("/users/:id", UserParamsSchema, input.params)
  .split("/")
  .filter(Boolean)
  .slice(0, -1);

type Options = UseMutationOptions<
  z.output<typeof UserSchema>,
  QueryError,
  UpdateUserInput
> & {
  queryKeyInvalidation?: string[] | ((response: z.output<typeof UserSchema> | undefined) => string[]);
};

export const useUpdateUserMutation = (options: Except<Options, "onSettled" | "mutationFn"> = {}) => {
  const axios = useAxiosInstance();
  const { queryKeyInvalidation } = options;

  const client = useQueryClient();

  return useMutation({
    mutationFn: (input: UpdateUserInput) => updateUser(axios, input),
    onSettled: (response, _error, variables) => {
      const invalidationKeys = typeof queryKeyInvalidation === "function"
        ? queryKeyInvalidation(response)
        : queryKeyInvalidation;

      if (invalidationKeys) {
        client.invalidateQueries({ queryKey: invalidationKeys });
        return;
      }

      client.invalidateQueries({ queryKey: updateUserInvalidationKey(variables) });
    },
    ...options,
  });
};
"
`;

